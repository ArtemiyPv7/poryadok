            </div>
            
            <div class="settings-section">
                <div class="settings-title">Уведомления</div>
                <div class="setting-item">
                    <div class="setting-label">Напоминание о дейликах</div>
                    <div class="toggle on"></div>
                </div>
                <div class="setting-item">
                    <div class="setting-label">Умные подсказки</div>
                    <div class="toggle on"></div>
                </div>
                <div class="setting-item">
                    <div class="setting-label">Время напоминания</div>
                    <div style="font-size: 14px; color: #8A8A8A;">09:00</div>
                </div>
                
                <div class="settings-title">Внешний вид</div>
                <div class="setting-item">
                    <div class="setting-label">Тёмная тема</div>
                    <div class="toggle"></div>
                </div>
                
                <div class="settings-title">Звуки</div>
                <div class="setting-item">
                    <div class="setting-label">Вибро при завершении</div>
                    <div class="toggle on"></div>
                </div>
                <div class="setting-item">
                    <div class="setting-label">Звук при завершении</div>
                    <div class="toggle on"></div>
                </div>
            </div>
        </div>
        
        <!-- Bottom Nav -->
        <div class="bottom-nav">
            <div class="nav-item active" onclick="showScreen('home')">
                <span></span>
                <label>Дом</label>
            </div>
            <div class="nav-item" onclick="showScreen('scenarios')">
                <span>⚡</span>
                <label>Сценарии</label>
            </div>
            <div class="nav-item" onclick="showScreen('stats')">
                <span>📊</span>
                <label>Стата</label>
            </div>
            <div class="nav-item" onclick="showScreen('settings')">
                <span></span>
                <label>Настройки</label>
            </div>
        </div>
    </div>
    
    <script>
        function showScreen(name) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('screen-' + name).classList.add('active');
            event.currentTarget.classList.add('active');
        }
        
        // Energy filter toggle
        document.querySelectorAll('.energy-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.energy-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
            });
        });
        
        // Task check toggle
        document.querySelectorAll('.task-check').forEach(check => {
            check.addEventListener('click', function() {
                this.classList.toggle('done');
                this.textContent = this.classList.contains('done') ? '✓' : '';
                const title = this.closest('.daily-task').querySelector('.task-title');
                title.classList.toggle('done');
            });
        });
        
        // Toggle switches
        document.querySelectorAll('.toggle').forEach(toggle => {
            toggle.addEventListener('click', function() {
                this.classList.toggle('on');
            });
        });
    </script>
</body>
</html>
