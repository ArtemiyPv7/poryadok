    <title>CleanApp - Full Mockup</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #e8e6e1;
            padding: 20px;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .phone-frame {
            max-width: 375px;
            width: 100%;
            height: 750px;
            background: #F5F3EF;
            border-radius: 40px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            color: #2D2D2D;
            position: relative;
            display: flex;
            flex-direction: column;
        }
        
        .status-bar {
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            font-weight: 600;
            color: #8A8A8A;
            flex-shrink: 0;
        }
        
        /* Screens */
        .screen {
            flex: 1;
            overflow-y: auto;
            display: none;
            padding-bottom: 70px;
        }
        
        .screen.active {
            display: block;
        }
        
        .screen::-webkit-scrollbar { display: none; }
        
        /* Header */
        .header {
            padding: 5px 20px 15px;
        }
        
        .greeting {
            font-size: 14px;
            color: #8A8A8A;
